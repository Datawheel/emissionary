{
  "name": "emissionary",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pretest": "npm run validate",
    "e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env db/migrate.ts",
    "db:sync": "tsx --env-file=.env scripts/sync-items.ts",
    "data:items": "tsx scripts/build-items.ts && tsx scripts/generate-sources-md.ts",
    "data:countries": "tsx scripts/update-country-factors.ts && tsx scripts/build-country-names.ts && tsx scripts/generate-sources-md.ts",
    "og": "tsx --env-file-if-exists=.env scripts/render-og.ts",
    "package": "mkdir -p dist && git archive --format=zip --prefix=emissionary/ -o dist/emissionary-$(date +%Y-%m-%d).zip HEAD && echo \"wrote dist/emissionary-$(date +%Y-%m-%d).zip\""
  },
  "description": "A carbon-intuition guessing game for the OEC",
  "dependencies": {
    "jose": "^6.2.12",
    "marked": "^18.0.6",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "i18n-iso-countries": "^7.14.0",
    "tsx": "^4.23.1",
    "typescript": "5.9",
    "vitest": "^4.1.10"
  },
  "private": true,
  "type": "module"
}
