# Copy to .env and fill in. Production refuses to start while the two secrets
# below still hold these placeholder values.

# PostgreSQL connection string
DATABASE_URL=postgres://emissionary:emissionary_dev@localhost:5432/emissionary

# HMAC key for player-token cookies. Generate: openssl rand -hex 32
PLAYER_TOKEN_SECRET=change_me_dev_secret

# Seeds the deterministic daily sets. Generate: openssl rand -hex 32
# Never change after launch — it would change every past and future daily game.
DAILY_SALT=change_me_daily_salt

# UTC date of Daily Game #1; drives the share-card day counter (#N).
LAUNCH_DATE=2026-09-01

# Public base URL (no trailing slash): used for social-preview links, and by
# scripts/render-og.ts to print your domain on the preview images.
SITE_URL=https://emissionary.example.org

# Password for /admin, which shows today's Daily Game answers. Use a long random
# value (openssl rand -base64 24). Leave unset to disable /admin entirely.
ADMIN_KEY=change_me_admin_key

# Shared with the OEC site (its GAMES_TOKEN_SECRET): verifies the signed identity
# the parent sends when Emissionary is embedded in oec.world. Leave unset to keep
# everyone anonymous. Never commit the real value.
GAMES_TOKEN_SECRET=
