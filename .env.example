# Copy to .env and adjust for the environment.
DATABASE_URL=postgres://emissionary:emissionary_dev@localhost:5432/emissionary
# HMAC key for player-token cookies. Generate: openssl rand -hex 32
PLAYER_TOKEN_SECRET=change_me_dev_secret
# Salt for deterministic daily set generation. Never change after launch.
DAILY_SALT=change_me_daily_salt
# UTC date of launch; drives the share-card day counter (#N).
LAUNCH_DATE=2026-09-01
